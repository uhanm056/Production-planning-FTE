rules_version = '2';
// Plánování FTE – online verze (projekt mec---action-plan, Firestore; MEC používá Realtime Database a jeho pravidla to nemění).
// Přístup: přihlášený a ověřený e-mail (nebo účet Microsoft) se záznamem fte_acl/{email} s rolí admin / edit / view.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null
        && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'microsoft.com');
    }
    function mail() { return request.auth.token.email.lower(); }
    function aclPath() { return /databases/$(database)/documents/fte_acl/$(mail()); }
    function hasRole(roles) { return signedIn() && exists(aclPath()) && get(aclPath()).data.role in roles; }

    // data aplikace: každý dokument = {j: JSON, at, by}
    match /fte/main/{coll}/{id} {
      allow read: if hasRole(['admin', 'edit', 'view']);
      allow delete: if hasRole(['admin', 'edit']);
      allow create, update: if hasRole(['admin', 'edit'])
        && request.resource.data.keys().hasOnly(['j', 'at', 'by'])
        && request.resource.data.j is string
        && request.resource.data.by == request.auth.token.email;
    }

    // seznam přístupů: správce přidává úpravy / jen čtení; správce (admin) se zakládá jen ve Firebase konzoli
    match /fte_acl/{m} {
      allow get: if signedIn() && m == mail();
      allow read: if hasRole(['admin']);
      allow create, update: if hasRole(['admin'])
        && request.resource.data.role in ['edit', 'view']
        && (resource == null || resource.data.role != 'admin');
      allow delete: if hasRole(['admin']) && resource.data.role != 'admin';
    }
  }
}
